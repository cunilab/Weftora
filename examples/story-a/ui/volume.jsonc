{
  "screenSchema": 1,
  "root": {
    "type": "overlay",
    "id": "volume",
    "background": "#060B14C9",
    "layout": {
      "width": "100%",
      "height": "100%",
      "padding": 32
    },
    "children": [
      {
        "type": "panel",
        "background": "#152235FF",
        "layout": {
          "padding": 24,
          "gap": 12,
          "position": "absolute",
          "left": "18%",
          "right": "18%",
          "top": 32
        },
        "children": [
          {
            "type": "text",
            "text": "Audio settings",
            "size": 28
          },
          {
            "type": "list",
            "layout": {
              "direction": "row",
              "gap": 10
            },
            "children": [
              {
                "type": "text",
                "text": "Master",
                "size": 18,
                "layout": {
                  "width": 110
                }
              },
              {
                "type": "text",
                "bind": {
                  "state": "settings.audio.master"
                },
                "size": 16,
                "color": "#A3B5CC",
                "layout": {
                  "width": 50
                }
              },
              {
                "type": "button",
                "id": "master.mute",
                "text": "Mute",
                "action": {
                  "do": "state.set",
                  "key": "settings.audio.master",
                  "value": 0.0
                },
                "layout": {
                  "padding": 12
                },
                "size": 20
              },
              {
                "type": "button",
                "id": "master.half",
                "text": "50%",
                "action": {
                  "do": "state.set",
                  "key": "settings.audio.master",
                  "value": 0.5
                },
                "layout": {
                  "padding": 12
                },
                "size": 20
              },
              {
                "type": "button",
                "id": "master.full",
                "text": "100%",
                "action": {
                  "do": "state.set",
                  "key": "settings.audio.master",
                  "value": 1.0
                },
                "layout": {
                  "padding": 12
                },
                "size": 20
              }
            ]
          },
          {
            "type": "list",
            "layout": {
              "direction": "row",
              "gap": 10
            },
            "children": [
              {
                "type": "text",
                "text": "Music",
                "size": 18,
                "layout": {
                  "width": 110
                }
              },
              {
                "type": "text",
                "bind": {
                  "state": "settings.audio.music"
                },
                "size": 16,
                "color": "#A3B5CC",
                "layout": {
                  "width": 50
                }
              },
              {
                "type": "button",
                "id": "music.mute",
                "text": "Mute",
                "action": {
                  "do": "state.set",
                  "key": "settings.audio.music",
                  "value": 0.0
                },
                "layout": {
                  "padding": 12
                },
                "size": 20
              },
              {
                "type": "button",
                "id": "music.half",
                "text": "50%",
                "action": {
                  "do": "state.set",
                  "key": "settings.audio.music",
                  "value": 0.5
                },
                "layout": {
                  "padding": 12
                },
                "size": 20
              },
              {
                "type": "button",
                "id": "music.full",
                "text": "100%",
                "action": {
                  "do": "state.set",
                  "key": "settings.audio.music",
                  "value": 1.0
                },
                "layout": {
                  "padding": 12
                },
                "size": 20
              }
            ]
          },
          {
            "type": "list",
            "layout": {
              "direction": "row",
              "gap": 10
            },
            "children": [
              {
                "type": "text",
                "text": "Effects",
                "size": 18,
                "layout": {
                  "width": 110
                }
              },
              {
                "type": "text",
                "bind": {
                  "state": "settings.audio.effects"
                },
                "size": 16,
                "color": "#A3B5CC",
                "layout": {
                  "width": 50
                }
              },
              {
                "type": "button",
                "id": "effects.mute",
                "text": "Mute",
                "action": {
                  "do": "state.set",
                  "key": "settings.audio.effects",
                  "value": 0.0
                },
                "layout": {
                  "padding": 12
                },
                "size": 20
              },
              {
                "type": "button",
                "id": "effects.half",
                "text": "50%",
                "action": {
                  "do": "state.set",
                  "key": "settings.audio.effects",
                  "value": 0.5
                },
                "layout": {
                  "padding": 12
                },
                "size": 20
              },
              {
                "type": "button",
                "id": "effects.full",
                "text": "100%",
                "action": {
                  "do": "state.set",
                  "key": "settings.audio.effects",
                  "value": 1.0
                },
                "layout": {
                  "padding": 12
                },
                "size": 20
              }
            ]
          },
          {
            "type": "list",
            "layout": {
              "direction": "row",
              "gap": 10
            },
            "children": [
              {
                "type": "text",
                "text": "Ambience",
                "size": 18,
                "layout": {
                  "width": 110
                }
              },
              {
                "type": "text",
                "bind": {
                  "state": "settings.audio.ambience"
                },
                "size": 16,
                "color": "#A3B5CC",
                "layout": {
                  "width": 50
                }
              },
              {
                "type": "button",
                "id": "ambience.mute",
                "text": "Mute",
                "action": {
                  "do": "state.set",
                  "key": "settings.audio.ambience",
                  "value": 0.0
                },
                "layout": {
                  "padding": 12
                },
                "size": 20
              },
              {
                "type": "button",
                "id": "ambience.half",
                "text": "50%",
                "action": {
                  "do": "state.set",
                  "key": "settings.audio.ambience",
                  "value": 0.5
                },
                "layout": {
                  "padding": 12
                },
                "size": 20
              },
              {
                "type": "button",
                "id": "ambience.full",
                "text": "100%",
                "action": {
                  "do": "state.set",
                  "key": "settings.audio.ambience",
                  "value": 1.0
                },
                "layout": {
                  "padding": 12
                },
                "size": 20
              }
            ]
          },
          {
            "type": "list",
            "layout": {
              "direction": "row",
              "gap": 10
            },
            "children": [
              {
                "type": "text",
                "text": "Voice",
                "size": 18,
                "layout": {
                  "width": 110
                }
              },
              {
                "type": "text",
                "bind": {
                  "state": "settings.audio.voice"
                },
                "size": 16,
                "color": "#A3B5CC",
                "layout": {
                  "width": 50
                }
              },
              {
                "type": "button",
                "id": "voice.mute",
                "text": "Mute",
                "action": {
                  "do": "state.set",
                  "key": "settings.audio.voice",
                  "value": 0.0
                },
                "layout": {
                  "padding": 12
                },
                "size": 20
              },
              {
                "type": "button",
                "id": "voice.half",
                "text": "50%",
                "action": {
                  "do": "state.set",
                  "key": "settings.audio.voice",
                  "value": 0.5
                },
                "layout": {
                  "padding": 12
                },
                "size": 20
              },
              {
                "type": "button",
                "id": "voice.full",
                "text": "100%",
                "action": {
                  "do": "state.set",
                  "key": "settings.audio.voice",
                  "value": 1.0
                },
                "layout": {
                  "padding": 12
                },
                "size": 20
              }
            ]
          },
          {
            "type": "button",
            "id": "close",
            "text": "Close (Esc)",
            "action": {
              "do": "screen.close"
            },
            "layout": {
              "padding": 12
            },
            "size": 20
          }
        ]
      }
    ]
  }
}
