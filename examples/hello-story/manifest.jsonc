// Hello Story: the Phase 0 walking-skeleton Story.
// Format: JSONC (JSON with comments and trailing commas), see docs/adr/0004-story-authoring-format.md.
{
  "manifestSchema": 1,
  "id": "dev.weftora.hello-story",
  "storyVersion": "0.1.0",
  "requires": {
    "engineApi": ">=0.1.0 <0.2.0",
    "capabilities": ["dialogue.yarn/1", "assets.catalog/1"],
  },
  "title": "Hello Story",

  // Yarn node the game starts at.
  "entrypoint": "Start",
  "dialogue": ["dialogue/intro.yarn"],

  // Typed asset IDs used by the same Yarn background/sound commands.
  "catalogs": {
    "images": ["assets/images.jsonc"],
    "audio": ["assets/audio.jsonc"],
  },

  "initialState": {
    "curious": false,
  },
}
