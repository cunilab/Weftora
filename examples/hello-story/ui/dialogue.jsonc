{
  "screenSchema": 1,
  "root": {
    "type": "screen", "id": "dialogue",
    "layout": {"width": "100%", "height": "100%"},
    "children": [
      {"type": "image", "image": "bg.room", "layout": {"position": "absolute", "width": "100%", "height": "100%"}},
      {
        "type": "panel", "background": "#0A0A14E0",
        "layout": {"position": "absolute", "left": 24, "right": 24, "bottom": 24, "padding": 20, "gap": 10},
        "children": [
          {"type": "text", "bind": {"dialogue": "speaker"}, "size": 26, "color": "#F2C759"},
          {"type": "text", "bind": {"dialogue": "text"}, "size": 30},
          {"type": "choiceList", "id": "choices", "layout": {"gap": 8}},
          {
            "type": "list", "layout": {"direction": "row", "gap": 12},
            "children": [
              {"type": "button", "id": "next", "text": "Next", "action": {"do": "dialogue.advance"}, "layout": {"padding": 10}},
              {"type": "button", "id": "details", "text": "Details", "action": {"do": "screen.open", "screen": "details"}, "layout": {"padding": 10}},
              {"type": "text", "text": "Curious:"},
              {"type": "text", "bind": {"state": "curious"}}
            ]
          }
        ]
      }
    ]
  }
}
