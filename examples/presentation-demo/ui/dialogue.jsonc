{
  "screenSchema": 1,
  "root": {
    "type": "screen",
    "id": "dialogue",
    "layout": {
      "width": "100%",
      "height": "100%"
    },
    "children": [
      {
        "type": "panel",
        "background": "#0B1220F2",
        "layout": {
          "position": "absolute",
          "left": "6%",
          "right": "6%",
          "bottom": 28,
          "padding": 28,
          "gap": 14
        },
        "children": [
          {
            "type": "text",
            "bind": {
              "dialogue": "speaker"
            },
            "size": 18,
            "color": "#F2BF6D"
          },
          {
            "type": "text",
            "bind": {
              "dialogue": "text"
            },
            "size": 26,
            "color": "#EDF2F8"
          },
          {
            "type": "choiceList",
            "id": "choices",
            "layout": {
              "gap": 8
            },
            "size": 22,
            "color": "#EDF2F8"
          },
          {
            "type": "list",
            "layout": {
              "direction": "row",
              "gap": 12
            },
            "children": [
              {
                "type": "button",
                "id": "next",
                "text": "Next",
                "action": {
                  "do": "dialogue.advance"
                },
                "layout": {
                  "padding": 12
                },
                "size": 20,
                "background": "#F2BF6D",
                "color": "#101723"
              },
              {
                "type": "button",
                "id": "volume",
                "text": "Volume",
                "action": {
                  "do": "screen.open",
                  "screen": "volume"
                },
                "layout": {
                  "padding": 12
                },
                "size": 16
              }
            ]
          }
        ]
      }
    ]
  }
}
