{
  "screenSchema": 1,
  "root": {
    "type": "screen",
    "id": "dialogue",
    "layout": {
      "width": "100%",
      "height": "100%"
    },
    "children": [
      {
        "type": "panel",
        "background": "#0A0A14E0",
        "layout": {
          "position": "absolute",
          "left": 24,
          "right": 24,
          "bottom": 24,
          "padding": 16,
          "gap": 8
        },
        "children": [
          {
            "type": "text",
            "bind": {
              "dialogue": "speaker"
            },
            "size": 22
          },
          {
            "type": "text",
            "bind": {
              "dialogue": "text"
            },
            "size": 24
          },
          {
            "type": "choiceList",
            "id": "choices"
          },
          {
            "type": "list",
            "layout": {
              "direction": "row",
              "gap": 12
            },
            "children": [
              {
                "type": "button",
                "id": "next",
                "text": "Next",
                "action": {
                  "do": "dialogue.advance"
                },
                "layout": {
                  "padding": 8
                }
              },
              {
                "type": "button",
                "id": "volume",
                "text": "Volume",
                "action": {
                  "do": "screen.open",
                  "screen": "volume"
                },
                "layout": {
                  "padding": 8
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
